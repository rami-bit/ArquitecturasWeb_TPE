{
  "info": {
    "_postman_id": "137b65b0-7e2b-4dad-956c-267d8756a339",
    "name": "tp3",
    "description": "Coleccion inicial para probar los endpoints REST implementados en TP3. Los datos configurables se encuentran en las variables de la coleccion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Estudiantes",
      "item": [
        {
          "name": "Listar estudiantes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/estudiantes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "estudiantes"
              ]
            },
            "description": "Recupera todos los estudiantes sin un orden explicito."
          },
          "response": []
        },
        {
          "name": "Listar estudiantes ordenados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/estudiantes/orden?orden={{orden_estudiantes}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "estudiantes",
                "orden"
              ],
              "query": [
                {
                  "key": "orden",
                  "value": "{{orden_estudiantes}}",
                  "description": "Valores admitidos: nombre, apellido, edad o dni."
                }
              ]
            },
            "description": "Recupera todos los estudiantes ordenados según la variable orden_estudiantes."
          },
          "response": []
        },
        {
          "name": "Buscar estudiante por DNI",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/estudiantes/{{dni_consulta}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "estudiantes",
                "{{dni_consulta}}"
              ]
            },
            "description": "El endpoint actual busca por la clave primaria DNI, aunque la consigna pide buscar por numero de libreta."
          },
          "response": []
        },
        {
          "name": "Dar de alta un estudiante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": {{nuevo_estudiante_dni}},\n  \"nombre\": \"{{nuevo_estudiante_nombre}}\",\n  \"apellido\": \"{{nuevo_estudiante_apellido}}\",\n  \"edad\": {{nuevo_estudiante_edad}},\n  \"genero\": \"{{nuevo_estudiante_genero}}\",\n  \"ciudad\": \"{{nuevo_estudiante_ciudad}}\",\n  \"nroLibreta\": {{nuevo_estudiante_libreta}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/estudiantes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "estudiantes"
              ]
            },
            "description": "Crea un estudiante usando los valores configurados en las variables nuevo_estudiante_*."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Inscripciones",
      "item": [
        {
          "name": "Listar inscripciones",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/inscripciones",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "inscripciones"
              ]
            },
            "description": "Recupera todas las inscripciones existentes."
          },
          "response": []
        },
        {
          "name": "Matricular estudiante en carrera",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dni\": {{matricula_dni}},\n  \"idCarrera\": {{matricula_carrera_id}},\n  \"inscripcion\": {{matricula_anio_inscripcion}},\n  \"antiguedad\": {{matricula_antiguedad}},\n  \"graduacion\": {{matricula_anio_graduacion}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/inscripciones",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "inscripciones"
              ]
            },
            "description": "Matricula al estudiante y carrera indicados por las variables matricula_*. Ambos deben existir previamente. Un año de graduacion igual a 0 representa que todavía no se graduó."
          },
          "response": []
        }
      ]
    }
  ],
