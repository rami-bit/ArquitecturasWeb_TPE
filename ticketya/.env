# Configuracion completa de Docker Compose para desarrollo exclusivamente local.
# docker-compose.yml consume todos los valores de este archivo.
POSTGRES_DB=ticketya_catalog
INVENTORY_POSTGRES_DB=ticketya_inventory
TICKET_POSTGRES_DB=ticketya_ticket
PURCHASE_POSTGRES_DB=ticketya_purchase
PAYMENT_POSTGRES_DB=ticketya_payment
POSTGRES_USER=ticketya
POSTGRES_PASSWORD=ticketya

GATEWAY_PORT=8080
GATEWAY_SERVER_PORT=8080
GATEWAY_CATALOG_SERVICE_URL=http://catalog-service:8081
GATEWAY_INVENTORY_SERVICE_URL=http://inventory-service:8082
GATEWAY_PURCHASE_SERVICE_URL=http://purchase-service:8084

CATALOG_SERVER_PORT=8081
CATALOG_DB_URL=jdbc:postgresql://postgres:5432/ticketya_catalog
CATALOG_INVENTORY_SERVICE_URL=http://inventory-service:8082

INVENTORY_SERVER_PORT=8082
INVENTORY_DB_URL=jdbc:postgresql://inventory-db:5432/ticketya_inventory
INVENTORY_CATALOG_SERVICE_URL=http://catalog-service:8081
INVENTORY_HOLD_TTL_SECONDS=600

TICKET_SERVER_PORT=8083
TICKET_DB_URL=jdbc:postgresql://ticket-db:5432/ticketya_ticket
TICKET_QR_SIGNING_SECRET=ticketya-local-development-qr-signing-key-2026

PURCHASE_SERVER_PORT=8084
PURCHASE_DB_URL=jdbc:postgresql://purchase-db:5432/ticketya_purchase
PURCHASE_CATALOG_SERVICE_URL=http://catalog-service:8081
PURCHASE_INVENTORY_SERVICE_URL=http://inventory-service:8082
PURCHASE_PAYMENT_SERVICE_URL=http://payment-mock:8085
PURCHASE_TICKET_SERVICE_URL=http://ticket-service:8083
PURCHASE_TICKET_LIMIT=4

PAYMENT_SERVER_PORT=8085
PAYMENT_DB_URL=jdbc:postgresql://payment-db:5432/ticketya_payment
