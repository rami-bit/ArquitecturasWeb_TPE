# Configuracion completa de Docker Compose para desarrollo exclusivamente local.
# docker-compose.yml consume todos los valores de este archivo.
POSTGRES_DB=ticketya_catalog
INVENTORY_POSTGRES_DB=ticketya_inventory
TICKET_POSTGRES_DB=ticketya_ticket
PURCHASE_POSTGRES_DB=ticketya_purchase
PAYMENT_POSTGRES_DB=ticketya_payment
QUEUE_POSTGRES_DB=ticketya_queue
AUDIT_POSTGRES_DB=ticketya_audit
NOTIFICATION_POSTGRES_DB=ticketya_notification
POSTGRES_USER=ticketya
POSTGRES_PASSWORD=ticketya

# PDF-NF-CACHE: caché en memoria del catálogo publicado.
CATALOG_CACHE_TTL_SECONDS=30
CATALOG_CACHE_MAX_ENTRIES=200

GATEWAY_PORT=8080
GATEWAY_SERVER_PORT=8080
GATEWAY_CATALOG_SERVICE_URL=http://catalog-service:8081
GATEWAY_INVENTORY_SERVICE_URL=http://inventory-service:8082
GATEWAY_PURCHASE_SERVICE_URL=http://purchase-service:8084
GATEWAY_QUEUE_SERVICE_URL=http://queue-service:8086
GATEWAY_TICKET_SERVICE_URL=http://ticket-service:8083
GATEWAY_AUDIT_SERVICE_URL=http://audit-service:8086
GATEWAY_PREFERENCES_SERVICE_URL=http://preferences-service:8087
GATEWAY_NOTIFICATION_SERVICE_URL=http://notification-service:8088

# PDF-F10 - Preferencias y recomendaciones (MongoDB 7)
PREFERENCES_SERVER_PORT=8087
PREFERENCES_MONGODB_URI=mongodb://preferences-db:27017
PREFERENCES_MONGODB_DATABASE=ticketya_preferences
PREFERENCES_CATALOG_SERVICE_URL=http://catalog-service:8081
PREFERENCES_PURCHASE_SERVICE_URL=http://purchase-service:8084
PREFERENCES_CANDIDATE_LIMIT=200
PREFERENCES_HTTP_CONNECT_TIMEOUT_MS=2000
PREFERENCES_HTTP_READ_TIMEOUT_MS=5000

CATALOG_SERVER_PORT=8081
CATALOG_DB_URL=jdbc:postgresql://postgres:5432/ticketya_catalog
CATALOG_INVENTORY_SERVICE_URL=http://inventory-service:8082

INVENTORY_SERVER_PORT=8082
INVENTORY_DB_URL=jdbc:postgresql://inventory-db:5432/ticketya_inventory
INVENTORY_CATALOG_SERVICE_URL=http://catalog-service:8081
INVENTORY_HOLD_TTL_SECONDS=600

TICKET_SERVER_PORT=8083
TICKET_DB_URL=jdbc:postgresql://ticket-db:5432/ticketya_ticket
TICKET_QR_SIGNING_SECRET=ticketya-local-development-qr-signing-key-2026

PURCHASE_SERVER_PORT=8084
PURCHASE_DB_URL=jdbc:postgresql://purchase-db:5432/ticketya_purchase
PURCHASE_CATALOG_SERVICE_URL=http://catalog-service:8081
PURCHASE_INVENTORY_SERVICE_URL=http://inventory-service:8082
PURCHASE_PAYMENT_SERVICE_URL=http://payment-mock:8085
PURCHASE_TICKET_SERVICE_URL=http://ticket-service:8083
PURCHASE_QUEUE_SERVICE_URL=http://queue-service:8086
PURCHASE_TICKET_LIMIT=6

PAYMENT_SERVER_PORT=8085
PAYMENT_DB_URL=jdbc:postgresql://payment-db:5432/ticketya_payment

QUEUE_SERVER_PORT=8086
QUEUE_DB_URL=jdbc:postgresql://queue-db:5432/ticketya_queue
QUEUE_CATALOG_SERVICE_URL=http://catalog-service:8081
QUEUE_BATCH_SIZE=10
QUEUE_BATCH_INTERVAL_SECONDS=15
QUEUE_ADMISSION_TTL_SECONDS=120
QUEUE_ADMISSION_SECRET=ticketya-local-development-admission-secret-2026

# E2-02: bitácora centralizada (Audit Service). Catalog, Ticket y Purchase publican aquí.
AUDIT_SERVER_PORT=8086
AUDIT_DB_URL=jdbc:postgresql://audit-db:5432/ticketya_audit
AUDIT_SERVICE_URL=http://audit-service:8086

# Resiliencia (PDF-NF-RESILIENCE): circuit breaker de Payment y notificaciones.
PURCHASE_CIRCUIT_FAILURE_THRESHOLD=5
PURCHASE_CIRCUIT_OPEN_SECONDS=30
# Vacío = fallback local: eventos de notificación sólo en el log de Purchase.
# PDF-F11: Purchase y Catalog envían aquí sus hechos; vacía = sólo log local.
NOTIFICATION_SERVICE_URL=http://notification-service:8088
NOTIFICATION_SERVER_PORT=8088
NOTIFICATION_DB_URL=jdbc:postgresql://notification-db:5432/ticketya_notification
NOTIFICATION_PURCHASE_SERVICE_URL=http://purchase-service:8084
NOTIFICATION_PREFERENCES_SERVICE_URL=http://preferences-service:8087
NOTIFICATION_CHANNELS=EMAIL,PUSH
# SIMULATED registra cada envío en el log; FAILING simula la pasarela caída.
# Afecta sólo al proveedor PUSH; EMAIL siempre usa SMTP.
NOTIFICATION_PROVIDER_MODE=SIMULATED
NOTIFICATION_MAX_ATTEMPTS=6
NOTIFICATION_RETRY_BASE_DELAY_MS=2000
NOTIFICATION_SMTP_HOST=mailpit
NOTIFICATION_SMTP_PORT=1025
NOTIFICATION_SMTP_FROM=ticketya@localhost
NOTIFICATION_SMTP_CONNECT_TIMEOUT_MS=2000
NOTIFICATION_SMTP_READ_TIMEOUT_MS=5000

JWT_ISSUER_URI=http://host.docker.internal:19998
JWT_JWK_SET_URI=http://host.docker.internal:19998/.well-known/jwks.json
