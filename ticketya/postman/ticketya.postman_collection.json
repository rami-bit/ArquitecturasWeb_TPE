              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Disponibilidad pública de Inventory (público)",
      "request": {
        "method": "GET",
        "header": [],
        "body": {},
        "url": {
          "raw": "{{baseUrl}}/api/inventory/events/{{eventId}}/availability",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "inventory",
            "events",
            "{{eventId}}",
            "availability"
          ]
        },
        "description": "Inventory materializa el inventario desde el snapshot publicado de Catalog y devuelve la disponibilidad por sector. Sin precios ni datos sensibles."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"eventId\": \"{{eventId}}\",\n  \"generatedAt\": \"2030-06-01T21:00:00Z\",\n  \"sectors\": [\n    {\"sectorId\": \"...\", \"name\": \"Platea Numerada\", \"type\": \"NUMBERED\", \"capacity\": 3, \"sold\": 0, \"reserved\": 0, \"available\": 3, \"seats\": [{\"seatId\": \"...\", \"row\": \"A\", \"number\": 1, \"status\": \"AVAILABLE\"}]},\n    {\"sectorId\": \"...\", \"name\": \"General\", \"type\": \"GENERAL_ADMISSION\", \"capacity\": 500, \"sold\": 0, \"reserved\": 0, \"available\": 500, \"seats\": null}\n  ]\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status es 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Disponibilidad coincide con el evento y tiene sectores', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.eventId).to.eql(pm.variables.get('eventId'));",
              "  pm.expect(Array.isArray(json.sectors)).to.be.true;",
              "  pm.expect(json.sectors.length).to.be.at.least(2);",
              "});",
              "pm.test('Sector numerado expone asientos y no precios', function () {",
              "  const json = pm.response.json();",
              "  const numerado = json.sectors.find(s => s.type === 'NUMBERED');",
              "  const general = json.sectors.find(s => s.type === 'GENERAL_ADMISSION');",
              "  pm.expect(numerado).to.not.be.undefined;",
              "  pm.expect(general).to.not.be.undefined;",
              "  pm.expect(numerado.capacity).to.eql(3);",
              "  pm.expect(numerado.seats.length).to.eql(3);",
              "  pm.expect(general.capacity).to.eql(500);",
              "  JSON.stringify(json).includes('price') && pm.expect.fail('la disponibilidad no debe exponer price');",
              "});",
              "pm.test('Toda respuesta lleva X-Correlation-Id', function () {",
              "  pm.expect(pm.response.headers.get('X-Correlation-Id')).to.not.be.empty;",
              "});",
              "pm.test('Guarda los ids de Inventory para la compra', function () {",
              "  const json = pm.response.json();",
              "  const numerado = json.sectors.find(s => s.type === 'NUMBERED');",
              "  const general = json.sectors.find(s => s.type === 'GENERAL_ADMISSION');",
              "  pm.expect(numerado.sectorId).to.not.be.empty;",
              "  pm.expect(general.sectorId).to.not.be.empty;",
              "  pm.expect(numerado.seats.length).to.be.at.least(1);",
              "  const libre = numerado.seats.find(s => s.status === 'AVAILABLE') || numerado.seats[0];",
              "  pm.variables.set('inventorySectorNumeradoId', numerado.sectorId);",
              "  pm.variables.set('inventorySectorGeneralId', general.sectorId);",
              "  pm.variables.set('inventorySeatId', libre.seatId);",
              "});"
            ]
          }
        }
      ]
    },
