          ],
          "path": [
            "api",
            "management",
            "events",
            "{{eventId}}"
          ]
        },
        "description": "Edita los datos del borrador mientras está en DRAFT. Cambia nombres de participantes para evitar violar unicidad."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"id\": \"{{eventId}}\",\n  \"status\": \"DRAFT\"\n}"
