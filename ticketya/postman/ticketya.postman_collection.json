              "  pm.expect(json.status).to.eql('PUBLISHED');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Buscar eventos publicados (público)",
      "request": {
        "method": "GET",
        "header": [],
        "body": {},
        "url": {
          "raw": "{{baseUrl}}/api/events?participant=Artista {{runId}}&city=Buenos Aires&sort=price&direction=asc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events"
          ],
          "query": [
            {
              "key": "participant",
              "value": "Artista {{runId}}",
              "disabled": false
            },
            {
              "key": "city",
              "value": "Buenos Aires",
              "disabled": false
            },
            {
              "key": "sort",
              "value": "price",
              "disabled": false
            },
            {
              "key": "direction",
              "value": "asc",
              "disabled": false
            }
          ]
        },
        "description": "Búsqueda pública sin encabezados de identidad. Filtra por participante único y ciudad, ordena por menor precio."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"items\": [\n    {\n      \"id\": \"{{eventId}}\",\n      \"name\": \"Concierto {{runId}} - Edición\",\n      \"city\": \"Buenos Aires\"\n    }\n  ],\n  \"page\": 0,\n  \"size\": 20,\n  \"totalElements\": 1,\n  \"totalPages\": 1\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status es 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('El evento publicado aparece en resultados', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.items.some(i => i.id === pm.variables.get('eventId'))).to.be.true;",
              "});",
              "pm.test('Todos los resultados son PUBLISHED', function () {",
              "  const json = pm.response.json();",
              "  json.items.forEach(i => {",
              "    pm.expect(i.id).to.not.be.empty;",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Consultar detalle público del evento (público)",
      "request": {
        "method": "GET",
        "header": [],
        "body": {},
        "url": {
          "raw": "{{baseUrl}}/api/events/{{eventId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events",
            "{{eventId}}"
          ]
        },
        "description": "Detalle público del evento publicado: lugar, sectores, precios, participantes. Sin afirmación de disponibilidad de entradas."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"id\": \"{{eventId}}\",\n  \"status\": \"PUBLISHED\",\n  \"venueName\": \"Estadio {{runId}}\",\n  \"city\": \"Buenos Aires\",\n  \"secters\": [\n    {\"name\": \"Platea Numerada\", \"type\": \"NUMBERED\", \"price\": 25.00},\n    {\"name\": \"General\", \"type\": \"GENERAL_ADMISSION\", \"price\": 50.00}\n  ]\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status es 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Detalle tiene datos del snapshot', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.id).to.eql(pm.variables.get('eventId'));",
              "  pm.expect(json.venueName).to.contain('Estadio');",
              "  pm.expect(Array.isArray(json.sectors)).to.be.true;",
