          "path": ["api", "management", "events", "{{eventId}}", "suspend"]
        },
        "description": "Envía un X-Correlation-Id conocido y valida que el Gateway y Catalog Service lo ecoen en el encabezado de respuesta y en el cuerpo problem+json."
      },
      "event": [],
      "response": [
        {
          "name": "200 OK o 409",
          "status": "OK",
          "code": 200
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('Eco de X-Correlation-Id en encabezado', function () {",
              "  pm.response.to.have.header('X-Correlation-Id', 'test-correlation-12345');",
              "});",
              "pm.test('Eco de correlationId en body problem+json', function () {",
