              "});",
              "pm.test('Evento sigue en DRAFT', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('DRAFT');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Configurar ofertas de sectores (ORGANIZER)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}",
            "type": "text"
          },
          {
            "key": "X-User-Role",
            "value": "ORGANIZER",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"offerings\": [\n    {\n      \"sectorId\": \"{{sectorNumeradoId}}\",\n      \"price\": \"25.00\"\n    },\n    {\n      \"sectorId\": \"{{sectorGeneralId}}\",\n      \"price\": \"50.00\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/management/events/{{eventId}}/offerings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "management",
            "events",
            "{{eventId}}",
            "offerings"
          ]
        },
        "description": "Configura precios por sector para el borrador. Ambos sectores pertenecen al lugar creado."
      },
      "response": [
        {
          "name": "200 OK",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"id\": \"{{eventId}}\",\n  \"status\": \"DRAFT\"\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status es 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Ofertas configuradas, sigue en DRAFT', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('DRAFT');",
              "});"
            ]
          }
        }
      ]
    },
