      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status es 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Evento sigue en DRAFT', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('DRAFT');",
              "});"
            ]
          }
        }
      ]
    },
