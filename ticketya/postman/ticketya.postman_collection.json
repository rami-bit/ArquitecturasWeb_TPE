      "name": "13 - Crear orden con pago aprobado (cliente)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{buyerUserId}}",
            "type": "text"
          },
          {
            "key": "Idempotency-Key",
            "value": "purchase-{{runId}}-approved",
            "type": "text"
