            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"items\": [\n    {\"sectorId\": \"{{inventorySectorNumeradoId}}\", \"seatIds\": [\"{{inventorySeatId}}\"]},\n    {\"sectorId\": \"{{inventorySectorGeneralId}}\", \"quantity\": 1}\n  ],\n  \"payment\": {\"method\": \"CARD\", \"token\": \"tok_approved\"}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "description": "Crea la orden con un asiento numerado y un cupo de admisión general. Purchase consulta el snapshot de Catalog, reserva en Inventory, cobra en Payment Mock, confirma el inventario y emite los tickets. Devuelve 201 con la orden CONFIRMED."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status es 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('La orden queda CONFIRMED con pago aprobado', function () {",
              "  pm.expect(json.status).to.eql('CONFIRMED');",
              "  pm.expect(json.payment.status).to.eql('APPROVED');",
              "  pm.expect(json.currency).to.eql('ARS');",
              "  pm.expect(json.totalAmount).to.be.above(0);",
              "});",
              "pm.test('Cada unidad tiene su ticket con QR', function () {",
              "  const tickets = json.items.flatMap(i => i.tickets);",
              "  pm.expect(tickets.length).to.eql(2);",
              "  tickets.forEach(t => {",
              "    pm.expect(t.status).to.eql('ISSUED');",
              "    pm.expect(t.qrPayload).to.not.be.empty;",
              "    pm.expect(t.qrPngBase64).to.not.be.empty;",
              "  });",
              "});",
              "pm.test('Eco de X-Correlation-Id', function () {",
              "  pm.response.to.have.header('X-Correlation-Id', 'purchase-approved-' + pm.variables.get('runId'));",
              "});",
              "pm.test('Guarda orderId e Idempotency-Key', function () {",
              "  pm.variables.set('orderId', json.orderId);",
              "  pm.variables.set('orderIdempotencyKey', 'purchase-' + pm.variables.get('runId') + '-approved');",
              "  pm.expect(json.orderId).to.not.be.empty;",
              "});"
            ]
          }
        }
      ]
